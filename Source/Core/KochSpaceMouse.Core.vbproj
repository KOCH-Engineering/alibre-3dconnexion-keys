<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>KochSpaceMouse.Core</AssemblyName>
    <RootNamespace></RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionExplicit>On</OptionExplicit>
    <Version>0.6.0</Version>
    <Product>KOCH SpaceMouse (KOCH Engineering)</Product>
    <AssemblyTitle>KOCH SpaceMouse core</AssemblyTitle>
    <Company>KOCH Engineering</Company>
    <Authors>KOCH Engineering</Authors>
    <Copyright>(c) 2026 KOCH Engineering</Copyright>
    <Description>SpaceMouse LCD keys for Alibre Design.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RestoreAdditionalProjectSources>https://api.nuget.org/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <!-- Only if the .NET Framework 4.8 developer pack is not installed -->
  <ItemGroup Condition="'$(KochLocalBuild)' != 'true' And !Exists('$(MSBuildProgramFiles32)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.8')">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="defaults\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
